{
  "name": "emdash-phishing-decision-models",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare:data": "node scripts/prepare-data.mjs",
    "dev": "node scripts/prepare-data.mjs && astro dev",
    "build": "node scripts/prepare-data.mjs && astro build",
    "check": "npm run build && node --test scripts/verify.test.mjs",
    "social": "node scripts/social.mjs",
    "icons": "node scripts/icons.mjs",
    "preview": "npm run build && astro preview --host 127.0.0.1"
  },
  "dependencies": {
    "astro": "7.3.5"
  },
  "devDependencies": {
    "sharp": "0.35.5"
  }
}
